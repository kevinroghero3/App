<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingBottom="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:src="0x7f0700eb"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="@style/TextAppearance.AppCompat.Title"
            android:textSize="22sp"
            android:textColor="@android:color/background_dark"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/background_permission_rationale_title"
            android:lineSpacingMultiplier="1.1"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="center"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@android:color/background_dark"
            android:gravity="center"
            android:id="@+id/message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/background_permission_rationale_message"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <View
            android:background="#e0e0e0"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <Button
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:textColor="#1c73e7"
            android:id="@+id/btn_positive_action"
            android:background="@android:color/transparent"
            android:padding="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/background_permission_rationale_allow_always"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"/>
        <View
            android:background="#e0e0e0"
            android:layout_width="match_parent"
            android:layout_height="1dp"/> /&gt; 
        <Button
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:textSize="14sp"
            android:textColor="#1c73e7"
            android:id="@+id/btn_negative_action"
            android:background="@android:color/transparent"
            android:padding="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:textAllCaps="false"/>
    </LinearLayout>
</LinearLayout>
